# O token do bot, do painel de desenvolvedor do Gamerfy (começa com gfb_).
GAMERFY_BOT_TOKEN=gfb_...
# O backend público. Padrão: https://api.gamerfy.gg
GAMERFY_API_URL=https://api.gamerfy.gg
# O prefixo dos comandos. Padrão: /
MUSIC_PREFIX=/
# Tamanho máximo da fila por servidor. Padrão: 100
MUSIC_MAX_QUEUE=100
# A porta da landing page / health. Padrão: 80
PORT=80
# O link para adicionar o bot a um servidor: https://gamerfy.gg/bot/<clientId>
# (do painel de desenvolvedor). Sem ele, a página não mostra o botão de adicionar.
MUSIC_INSTALL_URL=
# Caminhos do yt-dlp e do ffmpeg, se não estiverem no PATH.
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
